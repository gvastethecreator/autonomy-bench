{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "oxc.disableNestedConfig": true,
  "oxc.fmt.disableNestedConfig": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "npm.scriptRunner": "vp",
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#2a3471",
    "titleBar.activeForeground": "#f4f4f4",
    "titleBar.inactiveBackground": "#222b5d",
    "titleBar.inactiveForeground": "#f4f4f4",
    "sash.hoverBorder": "#2a3471",
    "statusBar.background": "#4b5698",
    "statusBar.foreground": "#f4f4f4",
    "statusBarItem.hoverBackground": "#424c86",
    "statusBarItem.activeBackground": "#3c457a",
    "statusBar.debuggingBackground": "#473e7d",
    "statusBar.debuggingForeground": "#f4f4f4",
    "statusBarItem.remoteBackground": "#4b5698",
    "statusBarItem.remoteForeground": "#f4f4f4",
    "commandCenter.background": "#2f3a7f",
    "commandCenter.foreground": "#f4f4f4",
    "commandCenter.border": "#f4f4f438",
    "commandCenter.activeBackground": "#4f5892",
    "commandCenter.activeForeground": "#f4f4f4",
    "commandCenter.activeBorder": "#f4f4f44d",
    "commandCenter.inactiveForeground": "#f4f4f4",
    "commandCenter.inactiveBorder": "#f4f4f41f",
    "commandCenter.inactiveBackground": "#3b4586",
    "activityBar.background": "#333f8a",
    "activityBar.foreground": "#f4f4f4",
    "activityBar.inactiveForeground": "#f4f4f4b3",
    "activityBar.activeBackground": "#4a5597",
    "activityBar.activeBorder": "#6f49bc",
    "activityBarBadge.background": "#6f49bc",
    "activityBarBadge.foreground": "#f4f4f4",
    "activityBarTop.background": "#333f8a",
    "activityBarTop.foreground": "#f4f4f4",
    "activityBarTop.inactiveForeground": "#f4f4f4b3",
    "activityBarTop.activeBorder": "#6f49bc",
    "activityBarTop.activeBackground": "#4a5597"
  }
}
