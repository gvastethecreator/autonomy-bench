{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomy Bench Cell Receipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "cellId",
    "benchmarkId",
    "promptLevel",
    "attempt",
    "requestedModel",
    "promptSha256",
    "status",
    "adapter",
    "harness",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": ["complete", "blocked", "unavailable", "failed"]
    },
    "adapter": {
      "enum": ["manual", "agent", "prototype-lab"]
    },
    "harness": {
      "type": "string",
      "minLength": 1,
      "description": "Program that ran the cell (Cursor, Codex, Claude Code, ChatGPT, …). Not the same as adapter."
    }
  }
}
