{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomy Bench Cell Receipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "cellId",
    "benchmarkId",
    "promptLevel",
    "attempt",
    "requestedModel",
    "promptSha256",
    "status",
    "adapter",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "complete",
        "blocked",
        "unavailable",
        "failed"
      ]
    },
    "adapter": {
      "enum": [
        "manual",
        "agent",
        "prototype-lab"
      ]
    }
  }
}
