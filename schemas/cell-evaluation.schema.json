{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomy Bench Cell Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rubric", "artifactSha256", "capture", "task", "experienceReviews"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "rubric": {
      "const": "quality-v2"
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$",
      "description": "SHA-256 of the reviewed published index.html bytes."
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "capturedAt",
        "viewport",
        "observationMs",
        "runtime",
        "motion",
        "samples",
        "evidence"
      ],
      "properties": {
        "protocol": {
          "const": "browser-runtime-v2"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "observationMs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "loads",
            "canvasCount",
            "viewportFit",
            "pageErrors",
            "consoleErrors",
            "failedRequests",
            "document"
          ],
          "properties": {
            "loads": {
              "type": "boolean"
            },
            "canvasCount": {
              "type": "integer",
              "minimum": 0
            },
            "viewportFit": {
              "type": "boolean"
            },
            "pageErrors": {
              "$ref": "#/$defs/stringList"
            },
            "consoleErrors": {
              "$ref": "#/$defs/stringList"
            },
            "failedRequests": {
              "$ref": "#/$defs/stringList"
            },
            "document": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 0
                },
                "height": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "automaticChangePct",
            "interactionChangePct",
            "sustainedIntervals",
            "sampledIntervals"
          ],
          "properties": {
            "automaticChangePct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "interactionChangePct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "sustainedIntervals": {
              "type": "integer",
              "minimum": 0
            },
            "sampledIntervals": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "samples": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "atMs", "imageSha256", "nonBlankPct"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "atMs": {
                "type": "number",
                "minimum": 0
              },
              "imageSha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "nonBlankPct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/nonEmptyStringList"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "evidence"],
      "properties": {
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "loads",
            "coreExperience",
            "expectedBehavior",
            "runtimeStability",
            "viewportFit"
          ],
          "properties": {
            "loads": {
              "type": "boolean"
            },
            "coreExperience": {
              "type": "boolean"
            },
            "expectedBehavior": {
              "type": "boolean"
            },
            "runtimeStability": {
              "type": "boolean"
            },
            "viewportFit": {
              "type": "boolean"
            }
          }
        },
        "evidence": {
          "$ref": "#/$defs/nonEmptyStringList"
        }
      }
    },
    "experienceReviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer",
          "blind",
          "reviewedAt",
          "cohortId",
          "candidateCount",
          "placement",
          "facets",
          "evidence"
        ],
        "properties": {
          "reviewer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": ["human", "multimodal-model"]
              }
            }
          },
          "blind": {
            "const": true
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time"
          },
          "cohortId": {
            "type": "string",
            "minLength": 1
          },
          "candidateCount": {
            "type": "integer",
            "minimum": 1
          },
          "placement": {
            "type": "integer",
            "minimum": 1
          },
          "facets": {
            "$ref": "#/$defs/facets"
          },
          "evidence": {
            "$ref": "#/$defs/nonEmptyStringList"
          },
          "limitations": {
            "$ref": "#/$defs/stringList"
          }
        }
      }
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320
        },
        "height": {
          "type": "integer",
          "minimum": 320
        }
      }
    },
    "facet": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clarity", "motionInteraction", "composition", "craft"],
      "properties": {
        "clarity": {
          "$ref": "#/$defs/facet"
        },
        "motionInteraction": {
          "$ref": "#/$defs/facet"
        },
        "composition": {
          "$ref": "#/$defs/facet"
        },
        "craft": {
          "$ref": "#/$defs/facet"
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
