{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomy Bench Run Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "createdAt",
    "suite",
    "adapter",
    "cells"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "suite": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "adapter": {
      "enum": [
        "manual",
        "agent",
        "prototype-lab"
      ]
    },
    "cells": {
      "type": "array",
      "minItems": 1
    }
  }
}
