{
  "name": "benchmark",
  "main": "workers/gallery.ts",
  "compatibility_date": "2026-08-21",
  "preview_urls": true,
  "assets": {
    "directory": "./gallery",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "benchmark-votes",
      "database_id": "05937864-5a2a-4aba-8671-1586b238c685",
      "migrations_dir": "migrations",
    },
  ],
  "routes": [
    {
      "pattern": "benchmark.gvaste.dev",
      "custom_domain": true,
    },
  ],
}
